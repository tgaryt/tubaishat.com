# Nginx server block for tubaishat.com
# Origin server behind Cloudflare (SSL mode: Full strict).
#
# Verified against:
#   nginx reference:        https://nginx.org/en/docs/
#   Mozilla SSL Intermediate profile v5.7:
#                           https://ssl-config.mozilla.org/
#   Cloudflare Full Strict: https://developers.cloudflare.com/ssl/origin-configuration/ssl-modes/full-strict/
#   Cloudflare IPs:         https://www.cloudflare.com/ips-v4/ and /ips-v6/
#   OWASP Secure Headers:   https://owasp.org/www-project-secure-headers/
#
# CSP NOTE: The Content-Security-Policy header is emitted by PHP at runtime
# (src/Support/Csp.php) because it carries a per-request nonce for inline
# JSON-LD. Do NOT add CSP here. Browsers enforce the intersection of all CSP
# headers sent, so a static nginx CSP would either duplicate PHP's policy or
# introduce conflicts. Keep CSP in one place - PHP.

# ============================================================================
# HTTP -> HTTPS redirect for both apex and www
# ============================================================================
server {
	listen 80;
	listen [::]:80;
	server_name tubaishat.com www.tubaishat.com;
	return 301 https://tubaishat.com$request_uri;
}

# ============================================================================
# www -> apex redirect over HTTPS
# ============================================================================
server {
	listen 443 ssl;
	listen [::]:443 ssl;
	http2 on;

	server_name www.tubaishat.com;

	ssl_certificate /etc/ssl/certs/tubaishat.com.pem;
	ssl_certificate_key /etc/ssl/private/tubaishat.com.key;
	ssl_protocols TLSv1.2 TLSv1.3;

	return 301 https://tubaishat.com$request_uri;
}

# ============================================================================
# Apex: the actual site
# ============================================================================
server {
	listen 443 ssl;
	listen [::]:443 ssl;
	http2 on;

	server_name tubaishat.com;

	root /var/www/tubaishat.com/public;
	index index.php;

	server_tokens off;
	charset utf-8;

	# ------------------------------------------------------------------
	# TLS - Mozilla Intermediate profile v5.7 (Apr 2026)
	# Regenerate the cipher line from https://ssl-config.mozilla.org/
	# ------------------------------------------------------------------
	ssl_certificate /etc/ssl/certs/tubaishat.com.pem;
	ssl_certificate_key /etc/ssl/private/tubaishat.com.key;
	ssl_protocols TLSv1.2 TLSv1.3;
	# DHE-RSA-* ciphers from Mozilla Intermediate are intentionally omitted;
	# they require ssl_dhparam and are unused behind Cloudflare (edge negotiates ECDHE).
	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
	ssl_prefer_server_ciphers off;
	ssl_session_timeout 1d;
	ssl_session_cache shared:MozSSL:10m;
	ssl_session_tickets off;

	# ------------------------------------------------------------------
	# Restore real visitor IP from Cloudflare
	# Refresh CIDRs from https://www.cloudflare.com/ips-v4/ and /ips-v6/ periodically
	# ------------------------------------------------------------------
	set_real_ip_from 173.245.48.0/20;
	set_real_ip_from 103.21.244.0/22;
	set_real_ip_from 103.22.200.0/22;
	set_real_ip_from 103.31.4.0/22;
	set_real_ip_from 141.101.64.0/18;
	set_real_ip_from 108.162.192.0/18;
	set_real_ip_from 190.93.240.0/20;
	set_real_ip_from 188.114.96.0/20;
	set_real_ip_from 197.234.240.0/22;
	set_real_ip_from 198.41.128.0/17;
	set_real_ip_from 162.158.0.0/15;
	set_real_ip_from 104.16.0.0/13;
	set_real_ip_from 104.24.0.0/14;
	set_real_ip_from 172.64.0.0/13;
	set_real_ip_from 131.0.72.0/22;
	set_real_ip_from 2400:cb00::/32;
	set_real_ip_from 2606:4700::/32;
	set_real_ip_from 2803:f800::/32;
	set_real_ip_from 2405:b500::/32;
	set_real_ip_from 2405:8100::/32;
	set_real_ip_from 2a06:98c0::/29;
	set_real_ip_from 2c0f:f248::/32;
	real_ip_header CF-Connecting-IP;

	access_log /var/www/tubaishat.com.access.log;
	error_log /var/www/tubaishat.com.error.log;

	# ------------------------------------------------------------------
	# Security headers (static ones only - CSP is emitted by PHP)
	# OWASP Secure Headers Project recommendations
	# ------------------------------------------------------------------
	add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "DENY" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	add_header Permissions-Policy "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()" always;

	# ------------------------------------------------------------------
	# Gzip (Cloudflare handles Brotli at the edge; gzip covers CF<->origin)
	# ------------------------------------------------------------------
	gzip on;
	gzip_vary on;
	gzip_proxied any;
	gzip_comp_level 6;
	gzip_min_length 1024;
	gzip_types
		text/plain
		text/css
		text/xml
		text/javascript
		application/javascript
		application/json
		application/xml
		application/xml+rss
		application/manifest+json
		image/svg+xml;

	# ------------------------------------------------------------------
	# Long cache for built static assets under /assets/
	# ------------------------------------------------------------------
	location ~* ^/assets/.+\.(?:css|js|woff2?|ttf|otf|jpg|jpeg|png|gif|webp|avif|svg|ico|pdf)$ {
		expires 1y;
		add_header Cache-Control "public, immutable" always;
		access_log off;
	}

	# Long cache for root-level icons (favicon.svg + generated raster icons)
	location ~* ^/(?:favicon(?:-\d+)?|icon-\d+(?:-maskable)?|apple-touch-icon)\.(?:svg|png)$ {
		expires 1y;
		add_header Cache-Control "public, immutable" always;
		access_log off;
	}

	# Web App Manifest: override MIME type (nginx default mime.types has no .webmanifest entry)
	# W3C-registered type per https://www.w3.org/TR/appmanifest/
	location = /manifest.webmanifest {
		default_type application/manifest+json;
		expires 1h;
	}

	# Short cache for root-level text metadata
	location ~* \.(?:xml|txt)$ {
		expires 1h;
	}

	# ------------------------------------------------------------------
	# Front controller
	# ------------------------------------------------------------------
	location / {
		try_files $uri $uri/ /index.php?$query_string;
	}

	# ------------------------------------------------------------------
	# PHP-FPM
	# try_files $uri =404 per nginx/php.net guidance to prevent
	# "script not found" path-info exploits on arbitrary .php hits
	# ------------------------------------------------------------------
	location ~ \.php$ {
		try_files $uri =404;
		fastcgi_split_path_info ^(.+\.php)(/.+)$;
		fastcgi_pass unix:/run/php/php8.5-fpm.sock;
		fastcgi_index index.php;
		include fastcgi.conf;
	}

	# Deny all hidden files except ACME .well-known challenges
	location ~ /\.(?!well-known) {
		deny all;
		access_log off;
		log_not_found off;
	}
}
