{
	"name": "tubaishat.com",
	"version": "2.0.0",
	"description": "Personal portfolio for Rayyan Tubaishat - Full Stack Developer.",
	"author": "Rayyan Tubaishat",
	"license": "MIT",
	"private": true,
	"type": "commonjs",
	"engines": {
		"node": ">=22.12.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tgaryt/tubaishat.com.git"
	},
	"scripts": {
		"build:css": "npx @tailwindcss/cli -i ./resources/css/input.css -o ./public/assets/css/tailwind.min.css --minify",
		"watch:css": "npx @tailwindcss/cli -i ./resources/css/input.css -o ./public/assets/css/tailwind.min.css --watch",
		"build:icons": "node scripts/build-icons.js",
		"build:favicons": "node scripts/build-favicons.js",
		"build:sitemap": "node scripts/build-sitemap.js",
		"build": "npm run build:css && npm run build:icons && npm run build:favicons && npm run build:sitemap"
	},
	"devDependencies": {
		"@fortawesome/fontawesome-free": "7.2.0",
		"@tailwindcss/cli": "4.2.2",
		"devicon": "2.17.0",
		"sharp": "0.34.5",
		"tailwindcss": "4.2.2"
	}
}
