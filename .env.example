# Contact form variables: copy this file to .env and fill in the values.
# After changing .env, run npm run build and restart the server.

# Cloudflare Turnstile sitekey of the contact form widget; the only value that is sent to browsers.
TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key that the server uses to validate widget tokens.
TURNSTILE_SECRET_KEY=

# Hostname that Turnstile must report for a valid token; tubaishat.com when empty.
TURNSTILE_EXPECTED_HOSTNAME=

# Mailgun Domain Sending Key of the sending domain.
MAILGUN_API_KEY=

# Mailgun sending domain.
MAILGUN_DOMAIN=

# Mailgun region of the sending domain: us or eu.
MAILGUN_REGION=

# Sender address of the contact form messages, on the Mailgun sending domain.
CONTACT_FROM_EMAIL=

# Inbox that receives the contact form messages.
CONTACT_TO_EMAIL=
