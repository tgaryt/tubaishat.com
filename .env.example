# ============================================================================
# Application environment
# ============================================================================

# Controls error display (hidden in production) and future debug behavior.
# Valid values: production, local
APP_ENV=production

# ============================================================================
# Mailgun (https://app.mailgun.com)
# ============================================================================

# Private API key from the Mailgun dashboard under "API Keys".
# Never commit a real value. Copy it only into the server .env file.
MAILGUN_API_KEY=

# The verified sending domain configured in Mailgun.
# Must match exactly the domain shown in the Mailgun dashboard
# (with SPF, DKIM, and MX records set and green-checked).
MAILGUN_DOMAIN=mg.tubaishat.com

# Which Mailgun region to talk to. Pick the one shown in the dashboard.
# us -> https://api.mailgun.net
# eu -> https://api.eu.mailgun.net
MAILGUN_REGION=us

# ============================================================================
# Outbound mail identity (contact form)
# ============================================================================

# From: address used on every contact form email.
# Must be an address ON the verified MAILGUN_DOMAIN or Mailgun will reject.
MAIL_FROM_ADDRESS=contact@mg.tubaishat.com

# Display name shown on the From: header (human-readable).
MAIL_FROM_NAME="Tubaishat Contact Form"

# Inbox that receives every successful contact form submission.
MAIL_TO_ADDRESS=ba8lawa2023@gmail.com

# ============================================================================
# Session
# ============================================================================

# Cookie name PHP uses for the session.
# Short generic value hides the backend technology from casual inspection.
SESSION_COOKIE_NAME=tsid
