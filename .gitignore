# ============================================================================
# Dependencies
# ============================================================================
# Installed by `composer install` and `npm install`. Never commit these.
node_modules/
vendor/

# ============================================================================
# Build outputs (regenerated by `npm run build`)
# ============================================================================
# Tailwind CSS compiled from resources/css/input.css.
public/assets/css/tailwind.min.css

# Inline SVG icons copied from node_modules by scripts/build-icons.js.
public/assets/icons/

# PWA raster icons generated from public/favicon.svg by scripts/build-favicons.js.
public/favicon-32.png
public/icon-192.png
public/icon-512.png
public/icon-512-maskable.png
public/apple-touch-icon.png

# Sitemap regenerated with today's date by scripts/build-sitemap.js.
public/sitemap.xml

# ============================================================================
# Runtime data (created by PHP during requests)
# ============================================================================
# Per-IP rate limit state for the contact form.
storage/ratelimit/*
!storage/ratelimit/.gitkeep

# PHP session files.
storage/sessions/*
!storage/sessions/.gitkeep

# ============================================================================
# Secrets
# ============================================================================
# Never commit the real .env (only .env.example is tracked).
.env

# ============================================================================
# Logs / temporary files
# ============================================================================
npm-debug.log*
pnpm-debug.log*
error.log

# ============================================================================
# Tooling and editor
# ============================================================================
# Claude Code local memory and config.
CLAUDE.local.md
.claude/

# IDE workspace folders.
.vscode/
.idea/

# OS metadata files.
.DS_Store
Thumbs.db
desktop.ini

# Vim swap files.
*.swp
*.swo
