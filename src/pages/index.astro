---
// Home page: metadata, structured data, and the five sections.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import LetsTalk from '../components/LetsTalk.astro';
import { profile } from '../data/profile';

const title = `${profile.name} - ${profile.professionalTitle}`;
const description = 'Full Stack Developer based in Jordan with over 3 years of experience building and maintaining web applications end-to-end with PHP, Node.js, TypeScript, and MySQL.';
const home = new URL('/', Astro.site);
const website = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: profile.name,
	alternateName: home.hostname,
	url: home.href
};
---

<BaseLayout title={title} description={description}>
	<Fragment slot="head">
		<link rel="canonical" href={home.href} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={profile.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={home.href} />
		<meta property="og:image" content={new URL('/og-image.png', home).href} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="An RT monogram above Rayyan Tubaishat, Full Stack Developer, and tubaishat.com in white and gold lettering on a dark background" />
		<script type="application/ld+json" set:html={JSON.stringify(website)} />
	</Fragment>
	<Hero />
	<About />
	<Experience />
	<Skills />
	<LetsTalk />
</BaseLayout>
