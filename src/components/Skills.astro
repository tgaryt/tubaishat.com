---
// Skills section: the skill groups, each a heading and a list.
import { profile } from '../data/profile';
---

<section id="skills" class="section" aria-labelledby="skills-heading">
	<h2 id="skills-heading">Skills</h2>
	<div class="groups">
		{/* Renders each group as a heading and a list of skills. */}
		{
			profile.skills.map((group) => (
				<div class="group">
					<h3>{group.name}</h3>
					<ul>
						{/* Renders each skill as a list item. */}
						{group.items.map((skill) => <li>{skill}</li>)}
					</ul>
				</div>
			))
		}
	</div>
</section>

<style>
	.groups {
		display: grid;
		gap: 2.5rem;
	}

	.group {
		display: grid;
		grid-row: span 2;
		grid-template-rows: subgrid;
		row-gap: var(--space-4);
	}

	h3 {
		padding-top: var(--space-4);
		border-top: 1px solid var(--color-rule);
		color: var(--color-text-subtle);
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	ul {
		padding: 0;
		list-style: none;
	}

	li {
		color: var(--color-text);
		font-size: var(--text-lg);
		font-weight: 500;
	}

	@media (min-width: 30rem) {
		.groups {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 80rem) {
		.groups {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
